<?xml version="1.0" encoding="utf-8"?>
<!-- Azure App Service on Windows (iisnode). On Linux App Service this file is
     ignored; set the startup command to: node backend/src/server.js -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="backend/src/server.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <!-- Everything, including the front end in frontend/, is served by the Node app. -->
        <rule name="DynamicContent">
          <match url="/*"/>
          <action type="Rewrite" url="backend/src/server.js"/>
        </rule>
      </rules>
    </rewrite>
    <security><requestFiltering><requestLimits maxAllowedContentLength="10485760"/></requestFiltering></security>
    <iisnode nodeProcessCommandLine="node" watchedFiles="web.config;*.js"/>
  </system.webServer>
</configuration>
